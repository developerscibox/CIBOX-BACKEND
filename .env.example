# Variables de entorno del backend de Cibox.
# Copiar a .env y completar. La fuente de verdad de los nombres es
# src/config/env.js (esquema Zod: valida al arrancar y aborta si falta algo).
# NINGÚN valor real de este archivo debe llegar al repo.

# ── Obligatorias ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# MongoDB como replica set (rs0): las transacciones lo exigen.
MONGO_URI=mongodb://127.0.0.1:27017/cibox
# Mínimo 32 caracteres cada uno. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
GUEST_ID_SECRET=

# ── CORS (obligatorio en producción) ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5180
FRONTEND_URL=http://localhost:5173
MOBILE_DEEP_LINK=cibox://

# ── Identidad de Cibox (override de src/config/brand.js) ─────────────────────
# Todo opcional: sin setear, se usan los valores del archivo de marca.
# BRAND_PHONE=
# BRAND_EMAIL=
# BRAND_EMAIL_SOPORTE=
# BRAND_ADDRESS_LINE1=
# BRAND_COMUNA=
# BRAND_SITE_URL=

# ── Despacho (override de src/config/despacho.js) ────────────────────────────
# PRECIO DEL DESPACHO, en pesos, por pedido. Tarifa plana: la misma para las
# cuatro comunas con reparto (Rancagua, Machalí, Graneros y Olivar) y sin
# depender del peso. Sin setear vale 3990, que es PROVISORIO. Cambiar acá evita
# tocar código; el valor definitivo lo fija el dueño.
# DESPACHO_TARIFA_CLP=3990

# ── Imágenes ─────────────────────────────────────────────────────────────────
# disk (dev, escribe en ./uploads) | cloudinary (producción)
UPLOAD_DRIVER=disk
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Seguimiento externo (Fase 6) ─────────────────────────────────────────────
# "log" = adapter falso que solo registra en log; no llama a ninguna API.
# Cuando se elija el proveedor real: escribir su adapter, registrarlo en
# integraciones/SeguimientoPort.js y poner su nombre aquí. Ver PLAN.md §5.
TRACKING_PROVIDER=log
# TRACKING_API_URL=
# TRACKING_API_KEY=
# TRACKING_ACCOUNT_ID=
# TRACKING_WEBHOOK_SECRET=

# ── Integraciones dormidas ───────────────────────────────────────────────────
# Correo (sin configurar: los emails no salen)
#
# En el servidor de producción (DigitalOcean) los puertos SMTP de salida
# (25/465/587) están bloqueados por su política antispam, así que allí el correo
# sale por HTTPS con Resend y las EMAIL_HOST/USER/PASS de abajo no se usan.
# En local sí funciona SMTP, que es para lo que siguen estando.
# RESEND_API_KEY=
# Remitente solo mientras Resend esté en sandbox (onboarding@resend.dev). Cuando
# cibox.cl quede verificado en resend.com/domains, borrar esta línea: manda EMAIL_FROM.
# RESEND_FROM=
# auto (elige sola: Resend si hay clave, si no SMTP) | resend | smtp | off
# EMAIL_TRANSPORT=auto
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# Datos bancarios para el pago por transferencia (texto multilínea)
# BANK_TRANSFER_INFO=

# Webpay: integration | production
WEBPAY_ENV=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=

# Boleta electrónica SII (hoy en stub)
SII_ENABLED=false
# SII_RUT_EMPRESA=
# SII_CERT_PATH=
# SII_CERT_PASSWORD=

# Bot de Telegram para aprobación de cambios de precio
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_CHAT_ID=
# TELEGRAM_APPROVER_IDS=

# ── Módulos comerciales contratados (csv) ────────────────────────────────────
MODULES_ENABLED=web,bodega,gerencia
