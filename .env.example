# Variables de entorno del backend de Cibox.
# Copiar a .env y completar. La fuente de verdad de los nombres es
# src/config/env.js (esquema Zod: valida al arrancar y aborta si falta algo).
# NINGÚN valor real de este archivo debe llegar al repo.

# ── Obligatorias ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# MongoDB como replica set (rs0): las transacciones lo exigen.
MONGO_URI=mongodb://127.0.0.1:27017/cibox
# Mínimo 32 caracteres cada uno. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
GUEST_ID_SECRET=

# ── CORS (obligatorio en producción) ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5180
FRONTEND_URL=http://localhost:5173
MOBILE_DEEP_LINK=cibox://

# ── Identidad de Cibox (override de src/config/brand.js) ─────────────────────
# Todo opcional: sin setear, se usan los valores del archivo de marca.
# BRAND_PHONE=
# BRAND_EMAIL=
# BRAND_EMAIL_SOPORTE=
# BRAND_ADDRESS_LINE1=
# BRAND_COMUNA=
# BRAND_SITE_URL=

# ── Imágenes ─────────────────────────────────────────────────────────────────
# disk (dev, escribe en ./uploads) | cloudinary (producción)
UPLOAD_DRIVER=disk
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Seguimiento externo (Fase 6) ─────────────────────────────────────────────
# "log" = adapter falso que solo registra en log; no llama a ninguna API.
# Cuando se elija el proveedor real: escribir su adapter, registrarlo en
# integraciones/SeguimientoPort.js y poner su nombre aquí. Ver PLAN.md §5.
TRACKING_PROVIDER=log
# TRACKING_API_URL=
# TRACKING_API_KEY=
# TRACKING_ACCOUNT_ID=
# TRACKING_WEBHOOK_SECRET=

# ── Integraciones dormidas ───────────────────────────────────────────────────
# Correo (sin configurar: los emails no salen)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# Datos bancarios para el pago por transferencia (texto multilínea)
# BANK_TRANSFER_INFO=

# Webpay: integration | production
WEBPAY_ENV=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=

# Boleta electrónica SII (hoy en stub)
SII_ENABLED=false
# SII_RUT_EMPRESA=
# SII_CERT_PATH=
# SII_CERT_PASSWORD=

# Bot de Telegram para aprobación de cambios de precio
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_CHAT_ID=
# TELEGRAM_APPROVER_IDS=

# ── Módulos comerciales contratados (csv) ────────────────────────────────────
MODULES_ENABLED=web,bodega,gerencia
